# Install at the domain document root after backing up the old site.
# Apache 2.4 / compatible LiteSpeed hosting with AllowOverride enabled.
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical hostname and HTTPS, scoped to the real domain (not staging).
  RewriteCond %{HTTP_HOST} ^www\.hdrmediasolutions\.co\.za$ [NC]
  RewriteRule ^ https://hdrmediasolutions.co.za%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTP_HOST} ^hdrmediasolutions\.co\.za$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
  RewriteRule ^ https://hdrmediasolutions.co.za%{REQUEST_URI} [R=301,L]

  # Preserve useful old links without sending every missing URL to the home page.
  RewriteRule ^portfolio/?$ /#films [R=301,L,NE]
  RewriteRule ^clients/?$ /#clients [R=301,L,NE]
  RewriteRule ^(?:services|about-us)/?$ /#services [R=301,L,NE]
  RewriteRule ^contact-us/?$ /#contact [R=301,L,NE]
  RewriteRule ^under-construction/?$ / [R=301,L]

  # Prevent duplicate index URLs; do not redirect internal directory indexes.
  RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+terms-of-service/index\.html(?:[?\s]) [NC]
  RewriteRule ^terms-of-service/index\.html$ /terms-of-service/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(?:html?|css|js|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(?:png|jpe?g|webp|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
  </FilesMatch>
  <FilesMatch "(?:\.[a-f0-9]{10}\.(?:css|js)|-[a-f0-9]{10}\.woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <Files "404.html">
    Header always set X-Robots-Tag "noindex"
  </Files>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml
</IfModule>
